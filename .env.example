# Copia este archivo a .env y ajusta los valores.
# Idioma del servicio (visor, mensajes de la API y su guía): es (castellano), eu (euskera) o en (inglés).
SMARTCITY_LANG=es
# Token opcional. Vacío = cualquiera puede modificar la ciudad (genera uno con: openssl rand -hex 24)
SMARTCITY_TOKEN=
# localhost para probar; un dominio público (con DNS apuntando al servidor) para HTTPS real; :80 para HTTP sin TLS
DOMAIN=localhost
# Puertos publicados (cámbialos si 80/443 están ocupados)
HTTP_PORT=80
HTTPS_PORT=443
CHECKPOINT_SECONDS=30
# Segundos simulados por segundo real (365/7 = una semana real es un año simulado). Fijo al crear la base de datos
SIM_SCALE=52.142857142857146
# Semilla de esta ciudad: decide el tráfico, el tiempo, los eventos y la variación diaria de la demanda.
# Pon una distinta en cada grupo para que cada ciudad sea un poco diferente (cualquier número entero).
# Vacío = la de siempre. Solo cuenta al crear la ciudad: para cambiarla hay que borrar su volumen (docker compose down -v).
SCENARIO_SEED=
# Demanda en hora punta (vacío = 3400 coches y 12000 peatones). La fija el servidor: no se puede cambiar por la API
MAX_CARS=
MAX_PEDESTRIANS=
# Clave del profesor para recibir los datos sin los fallos de los sensores (cabecera X-Raw-Key) y el registro de
# fallos (/api/faults.csv). Ponla también en el panel del profesor. No se la des a los alumnos (openssl rand -hex 24)
RAW_DATA_KEY=
# Fallos de los sensores (vacío = los de config.js). Tantos por uno: 0.001 = 0,1 %. Se pueden cambiar reiniciando la
# ciudad: solo cuentan para los datos que se graben desde entonces (lo ya grabado se sigue descargando igual).
# SENSOR_FAULTS: on / off. SENSOR_FAULT_RATE: filas de los históricos con un dato que falta o es imposible (0.001).
# SENSOR_MISSING_RATE: filas que no llegan (0.0005). SENSOR_COORD_RATE: filas de un sensor sin una coordenada (0.001).
# SENSOR_LIVE_RATE: datos de la API en vivo (0.0001).
SENSOR_FAULTS=
SENSOR_FAULT_RATE=
SENSOR_MISSING_RATE=
SENSOR_COORD_RATE=
SENSOR_LIVE_RATE=
# Chatbot de la ciudad: empieza escondido y se activa con el token de la ciudad desde su página de configuración,
# en otro puerto (docker compose --profile chat up -d; o chatadmin/docker-compose.yml desde otro equipo).
# CHAT_ADMIN_PASSWORD: contraseña opcional de esa página (usuario: admin). CHAT_ADMIN_PORT: su puerto (8095).
# Con --profile ollama arranca también un Ollama local (http://ollama:11434 desde la ciudad).
CHAT_ADMIN_PASSWORD=
CHAT_ADMIN_PORT=8095
