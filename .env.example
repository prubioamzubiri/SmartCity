# Copia este archivo a .env y ajusta los valores.
# Token opcional. Vacío = cualquiera puede modificar la ciudad (genera uno con: openssl rand -hex 24)
SMARTCITY_TOKEN=
# localhost para probar; un dominio público (con DNS apuntando al servidor) para HTTPS real; :80 para HTTP sin TLS
DOMAIN=localhost
# Puertos publicados (cámbialos si 80/443 están ocupados)
HTTP_PORT=80
HTTPS_PORT=443
CHECKPOINT_SECONDS=30
# Segundos simulados por segundo real (365/7 = una semana real es un año simulado). Fijo al crear la base de datos
SIM_SCALE=52.142857142857146
# Semilla de esta ciudad: decide el tráfico, el tiempo, los eventos y la variación diaria de la demanda.
# Pon una distinta en cada grupo para que cada ciudad sea un poco diferente (cualquier número entero).
# Vacío = la de siempre. Solo cuenta al crear la ciudad: para cambiarla hay que borrar su volumen (docker compose down -v).
SCENARIO_SEED=
# Demanda en hora punta (vacío = 1500 coches y 12000 peatones). La fija el servidor: no se puede cambiar por la API
MAX_CARS=
MAX_PEDESTRIANS=
