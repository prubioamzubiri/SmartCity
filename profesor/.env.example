# Copia este archivo a .env y ajusta los valores.
# URL de cada grupo (la base, sin /api), separadas por comas: nombre=url
PANEL_GROUPS=g1=https://grupo1.ejemplo.es,g2=https://grupo2.ejemplo.es,g3=https://grupo3.ejemplo.es,g4=https://grupo4.ejemplo.es
# Contraseña del panel (usuario: profesor). Genera una con: openssl rand -base64 18
PANEL_PASSWORD=
# Dominio del panel (localhost para probar, :80 para HTTP sin TLS)
DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443
# Segundos reales entre consultas a cada ciudad (5 s ≈ 4 min simulados)
POLL_SECONDS=5
