FROM node:24-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.js ./
COPY src ./src
# El mapa no está en Git: ejecuta "npm run fetch-osm" antes de construir la imagen.
COPY public ./public
# Visor en la raíz del dominio y API en el mismo origen (el proxy reenvía /api al simulador).
ENV VITE_BASE=/ VITE_API_URL=/
RUN npx vite build

FROM nginx:1-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
